# Default active key (Free Tier)
GEMINI_API_KEY=your_free_tier_google_ai_studio_api_key_here

# Optional Paid Tier backup key
GEMINI_API_KEY_PAID=your_paid_tier_google_ai_studio_api_key_here

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=postgres

# GitHub configuration
GITHUB_PAT=your_github_pat_here
GITHUB_REPO=https://github.com/NIDhesh04/recordnote
